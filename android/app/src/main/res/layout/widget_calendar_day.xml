<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calendar_day_cell"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:layout_margin="0dp"
    android:background="@drawable/widget_calendar_cell"
    android:orientation="vertical"
    android:padding="1dp">
    <TextView
        android:id="@+id/calendar_day"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="#303744"
        android:textSize="11sp" />
    <TextView
        android:id="@+id/calendar_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#8A91A0"
        android:textSize="8sp" />
    <LinearLayout
        android:id="@+id/calendar_day_events"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
